# Canonical site URL for metadata, OG images, and PWA (include https in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Harihar Solar acquisition calculator — WhatsApp wa.me link (digits only, country code, no +)
# NEXT_PUBLIC_HARIHAR_WHATSAPP_E164=919993322267

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Design Studio — Google Maps browser key.
# Enable Maps JavaScript API + Geocoding API, attach billing, and restrict by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Documents Hub — proposal PPTX persist on pricing snapshot (default on)
# DOCUMENTS_HUB_PROPOSAL_PERSIST=true
# Ops scripts only: ALLOW_LEGACY_DOCUMENT_SCRIPT_MUTATIONS=true for approved backfill/revert on legacy tables
# Server-only optional admin allowlist fallback (comma-separated):
ADMIN_USER_IDS=
ADMIN_PHONES=

# ── Subscriber auth (Wave 1 — OTP login) ───────────────────────────────────────
# Cookie signing secret (optional; falls back to SUPABASE_SERVICE_ROLE_KEY).
AUTH_SESSION_SECRET=
# When true, installer app routes require /login session (default: off — soft rollout).
AUTH_REQUIRE_LOGIN=false
# When true (or NODE_ENV≠production), OTP is returned in API for testing.
# Keep false in real production once SMS/WhatsApp delivery is wired.
AUTH_DEV_MODE=true
# Dangerous: first OTP login claims an org with zero members. Keep false so
# Sol.52 and Harihar Solar stay separate — use invites / explicit onboarding instead.
AUTH_CLAIM_ORPHAN_ORG=false

# Server-only: bill training uploads (Storage + verified_bills_training). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# AI provider switch: anthropic
BILL_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional: claude-haiku-4-5 | claude-sonnet-4-5 (legacy claude-3-5-* names auto-remap)
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-5
# Optional CSV fallback order if primary model is unavailable for your key.
# Example: claude-haiku-4-5-20251001,claude-sonnet-4-5-20250929
ANTHROPIC_MODEL_FALLBACKS=
ANTHROPIC_ENABLE_SONNET_FALLBACK=true
AI_MIN_PARSE_CONFIDENCE=45
AI_MIN_FILLED_MONTHS=3
ANTHROPIC_TIMEOUT_MS=45000

# ── Sol.52 CRM v2 — multi-source lead ingestion ──────────────────────────────
# Shared secret for server-to-server callers (your own backends, Zapier, etc.).
# Compute the header as: x-sol52-key = HMAC-SHA256(rawBody, SOL52_INBOUND_SECRET) hex.
SOL52_INBOUND_SECRET=

# WhatsApp Cloud API webhook (https://<host>/api/webhooks/whatsapp)
# WA_VERIFY_TOKEN is whatever string you typed into the Meta dashboard during
# the GET handshake. WA_APP_SECRET is the App Secret found at
# Meta App → Settings → Basic → App Secret. Used to verify
# `X-Hub-Signature-256` on every POST.
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# Meta Lead Ads webhook (https://<host>/api/webhooks/meta-leads)
# Same App Secret as above (re-declared for clarity); the long-lived Page
# Access Token is required so the webhook can call /<lead-id>?access_token=…
# to expand each leadgen ID into form fields.
META_APP_SECRET=
META_LEAD_PAGE_TOKEN=
META_VERIFY_TOKEN=
